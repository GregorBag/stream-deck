QWidget {
    color: #f4efff;
    font-family: "Segoe UI";
    font-size: 13px;
    selection-background-color: #9b3ac8;
}
QMainWindow, QDialog, QMenu, QMessageBox { background: #100c1c; }
QLabel { background: transparent; border: none; }
QWidget#main_shell, QWidget#configuration_page, QWidget#panel_simulator,
QWidget#settings_page { background: #100c1c; }
QFrame#brand_header {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #160d25,stop:1 #100c1c);
    border: 1px solid #38234c; border-radius: 12px;
}
QLabel#brand_title { font-size: 29px; font-weight: 800; letter-spacing: 1px; }
QLabel#brand_subtitle { color: #c59aed; font-size: 13px; letter-spacing: 5px; }
QLabel#panel_connection_status {
    color: #c4b2d9; background: #20162f; border: 1px solid #563866;
    border-radius: 12px; padding: 5px 12px; font-size: 11px;
}
QLabel[role="section_title"] { font-size: 20px; font-weight: 700; }
QLabel[role="card_name"] { font-size: 16px; font-weight: 700; }
QLabel[role="muted"], QLabel[role="status"] { color: #b9a7cf; font-size: 12px; }
QLabel[role="status"] { padding: 5px 0; }
QLabel[role="readout"] {
    font-size: 21px; font-weight: 700; color: #f5dbff; padding: 4px;
}
QGroupBox {
    background: #171225; border: 1px solid #49335f; border-radius: 11px;
    margin-top: 14px; padding: 14px 10px 10px; font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin; subcontrol-position: top left;
    padding: 0 8px; left: 10px; color: #ddc6f2;
}
QGroupBox#active_configuration { padding: 8px 4px 4px; }
QGroupBox[role="channel"] { background: #191329; border-color: #5b3e7a; padding: 4px; }
QGroupBox[role="sound"] {
    margin-top: 0; padding: 0; border-color: #a7438b;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #641448,stop:1 #31122f);
}
QGroupBox[role="sound"][accent="violet"] {
    border-color: #8045b9;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #4c1e7d,stop:1 #241536);
}
QGroupBox[role="sound"][accent="blue"] {
    border-color: #3b70b6;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #193e78,stop:1 #151f3b);
}
QGroupBox[role="preset"] { margin-top: 0; padding: 12px; border-color: #a1408f; }
QGroupBox[role="preset"][accent="violet"] { border-color: #8550b7; }
QGroupBox[role="preset"][accent="pink"] { border-color: #ac3d91; }
QWidget#presets_panel { background: #141020; border: 1px solid #3c2b50; border-radius: 11px; }
QTabWidget::pane { border: none; background: #100c1c; padding-top: 12px; }
QTabBar::tab {
    background: #1a142b; color: #bda7d9; border: 1px solid #3b2b51;
    border-bottom: 3px solid #3b2b51; border-top-left-radius: 8px;
    border-top-right-radius: 8px; padding: 13px 26px;
    min-width: 160px; font-size: 15px; font-weight: 600;
}
QTabBar::tab:selected {
    color: #fff3ff; border-color: #ad4aab; border-bottom-color: #ee57c4;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #44214e,stop:1 #2a1639);
}
QTabBar::tab:hover:!selected { background: #2a1d3c; color: #f5ddff; }
QPushButton {
    background: #2a203c; border: 1px solid #64477e; border-radius: 7px;
    padding: 7px 11px; min-height: 19px; color: #eee2ff;
}
QPushButton:hover { background: #3b2850; border-color: #bf76dc; }
QPushButton:pressed { background: #472550; border-color: #ef65c4; }
QPushButton:focus, QComboBox:focus, QLineEdit:focus { border: 1px solid #ef8cdb; }
QPushButton:checked { background: #842657; border-color: #ff69bc; color: #fff2fb; }
QPushButton:disabled { background: #211a2d; color: #897996; border-color: #3d304a; }
QPushButton[role="primary"] {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #bd288f,stop:1 #751b74);
    border-color: #db52b5; color: white; font-weight: 600;
}
QPushButton[role="primary"]:hover { background: #ba359e; border-color: #f18bd3; }
QPushButton[role="primary"]:pressed { background: #73205f; }
QPushButton[role="primary"]:disabled { background: #39233e; border-color: #59365e; color: #9b82a2; }
QPushButton[role="pad"] {
    min-height: 54px; font-size: 15px; font-weight: 600; border-color: #cb4ba7;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #8e216c,stop:1 #491840);
}
QPushButton[role="pad"][accent="violet"] { background: #53228a; border-color: #9f67db; }
QPushButton[role="pad"][accent="blue"] { background: #20477d; border-color: #558cda; }
QPushButton[role="pad"]:hover { background: #a03c8a; border-color: #fface0; }
QPushButton[role="pad"]:pressed { background: #4d1b53; }
QPushButton[role="pad"]:disabled { background: #231c32; border-color: #483652; color: #8c7c9e; }
QPushButton[role="compact"] { padding: 4px 8px; min-height: 16px; font-size: 11px; }
QComboBox, QLineEdit, QSpinBox {
    background: #141123; border: 1px solid #5e487e; border-radius: 6px;
    padding: 6px 9px; min-height: 20px; color: #eee6fa;
}
QComboBox { padding-right: 24px; }
QComboBox::drop-down { border: none; width: 23px; }
QComboBox::down-arrow { image: url(__DOWN_ARROW__); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #241a34; color: #f4efff; border: 1px solid #9160b7;
    selection-background-color: #803297; outline: none;
}
QSlider::groove:vertical { width: 9px; background: #36294e; border-radius: 4px; margin: 9px 0; }
QSlider::add-page:vertical { background: #bc37b5; border-radius: 4px; }
QSlider::sub-page:vertical { background: #36294e; border-radius: 4px; }
QSlider::handle:vertical {
    height: 18px; margin: 0 -6px; border-radius: 10px;
    background: #f5e4ff; border: 2px solid #bd7ae1;
}
QGroupBox[accent="violet"] QSlider::add-page:vertical { background: #9847e0; }
QGroupBox[accent="blue"] QSlider::add-page:vertical { background: #3f8de0; }
QSlider::handle:vertical:hover { background: #ffffff; border-color: #ff80d3; }
QSlider::add-page:vertical:disabled { background: #51405c; }
QSlider::handle:vertical:disabled { background: #8b7a9b; border-color: #675073; }
QSlider::groove:horizontal { height: 7px; background: #36294e; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #b83aad; border-radius: 3px; }
QSlider::handle:horizontal {
    width: 16px; margin: -6px 0; border-radius: 9px;
    background: #f1dfff; border: 2px solid #b570ce;
}
QCheckBox { spacing: 9px; padding: 6px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #78558b; border-radius: 4px; background: #20172f; }
QCheckBox::indicator:checked { background: #bc3ba4; image: url(__CHECK_MARK__); border-color: #ea8bd8; }
QScrollArea { border: none; background: #100c1c; }
QScrollBar:vertical { background: #171022; width: 10px; border-radius: 4px; }
QScrollBar::handle:vertical { background: #684178; min-height: 28px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: #171022; height: 10px; }
QScrollBar::handle:horizontal { background: #684178; min-width: 28px; border-radius: 4px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QStatusBar { background: #181023; color: #bda9d1; border-top: 1px solid #3f2a53; }
QStatusBar::item { border: none; }
QMenu { border: 1px solid #6e4385; padding: 6px; }
QMenu::item { padding: 7px 24px; border-radius: 5px; }
QMenu::item:selected { background: #713077; }
QToolTip { color: #f4efff; background: #291d3f; border: 1px solid #a363b9; padding: 5px; }
